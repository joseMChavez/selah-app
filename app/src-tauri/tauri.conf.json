{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selah",
  "mainBinaryName": "selah",
  "version": "0.1.0",
  "identifier": "org.selah.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Selah — Consola",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bibles/": "bibles/"
    },
    "category": "Utility",
    "publisher": "joseMChavez",
    "shortDescription": "Proyección y transmisión para iglesias",
    "longDescription": "Selah proyecta Biblia, textos e imágenes en la pantalla del templo y controla la transmisión en vivo con OBS.",
    "license": "GPL-3.0-only",
    "linux": {
      "deb": {
        "section": "video",
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
