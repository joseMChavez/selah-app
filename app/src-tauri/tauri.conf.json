{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmetPro",
  "mainBinaryName": "emetpro",
  "version": "0.9.0",
  "identifier": "org.emetpro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmetPro",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bibles/": "bibles/"
    },
    "category": "Utility",
    "publisher": "joseMChavez",
    "shortDescription": "Projection and live streaming for churches",
    "longDescription": "EmetPro projects Bible passages, lyrics, text, images, videos and presentations on the church screen, can be driven from a phone, and controls the live stream through OBS.",
    "license": "GPL-3.0-only",
    "linux": {
      "deb": {
        "section": "video",
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
